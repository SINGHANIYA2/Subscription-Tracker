PORT=5000
NODE_ENV=development

# PostgreSQL connection string (local Postgres or Neon)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/subtrack?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# Frontend origin(s) allowed by CORS (comma-separated for several)
CLIENT_URL="http://localhost:5173"

# Google OAuth Web Client ID (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# Set to 1 when deployed behind a proxy (Render, Heroku, ...) so rate limiting sees real IPs
TRUST_PROXY=0
